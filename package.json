{
  "name": "zero-slop",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic AI work standard: rules database, check engines, CLI, CLI gate, and the portable workflow skill library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trefeon/zero-slop.git"
  },
  "homepage": "https://github.com/trefeon/zero-slop",
  "bugs": {
    "url": "https://github.com/trefeon/zero-slop/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:rules": "tsx packages/core/src/validate.ts",
    "check:skills": "node scripts/check-skills.mjs",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "build": "tsc -p packages/core/tsconfig.json && tsc -p packages/cli/tsconfig.json",
    "build:core": "tsc -p packages/core/tsconfig.json"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
